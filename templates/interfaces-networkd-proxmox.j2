# network interface settings; autogenerated
# Please do NOT modify this file directly, unless you know what
# you're doing.
#
# If you want to manage parts of the network configuration manually,
# please utilize the 'source' or 'source-directory' directives to do
# so.
# PVE will preserve these directives, but will NOT read its network
# configuration from sourced files, so do not attempt to move any of
# the PVE managed interfaces into external files!
#
# Most of the configuration is located in systemd-networkd configuration files.
# We are using this file to configure the bridges for Proxmox VE
#
{% set networkd_interfaces = system_networkd.interfaces if (system_networkd.interfaces.items() | default([]) | length > 0) else {} %}
{% set networkd_bonds = system_networkd.bonds if (system_networkd.bonds.items() | default([]) | length > 0) else {} %}
{% set networkd_bridges = system_networkd.bridges if (system_networkd.bridges.items() | default([]) | length > 0) else {} %}
{% set bridge_ifaces = [] %}
{% for name, br in networkd_bridges.items() %}
{% set _ = bridge_ifaces.extend(br.interfaces | default([])) %}
{% endfor %}
{% for name, iface in networkd_interfaces.items() if name in bridge_ifaces %}

auto {{ name }}
iface {{ name }} inet manual
        mtu {{ iface.mtu | default(1500) }}
{% endfor %}
{% set bridges = [] %}
{% for name, br in networkd_bridges.items() %}

auto {{ name }}
{% if br.addresses is defined %}{% for addr in br.addresses %}
iface {{ name }} {{ 'inet6' if ':' in addr else 'inet' }} static
        address {{ addr }}
{% if name not in bridges %}{% set _ = bridges.extend([name]) %}
        bridge-ports {{ 'none' if br.interfaces is undefined else br.interfaces | join(' ') }}
        bridge-stp off
        bridge-fd 0
{% endif %}
        mtu {{ br.mtu | default(ansible_facts[name].mtu | default(1500)) }}
{% if br.preup is defined %}
        pre-up {{ br.preup }}
{% endif %}
{% if br.postup is defined %}
        post-up {{ br.postup }}
{% endif %}
{% endfor %}
{% if br.addresses is not defined or br.addresses | length == 0 %}
iface {{ name }} inet manual
        bridge-ports {{ 'none' if br.interfaces is undefined else br.interfaces | join(' ') }}
        bridge-stp off
        bridge-fd 0
{% endif %}
{% endif %}
{% endfor %}

#
source /etc/network/interfaces.d/*
